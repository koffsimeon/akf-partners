# ========================================================
# CONFIGURATION AKF PARTNERS — FICHIER .ENV UNIFIÉ
# ========================================================

# Supabase (Partagé automatiquement entre Frontend Vite et Backend Express)
SUPABASE_URL="https://votre-projet.supabase.co"

# Clé Publique (Frontend) : sb_publishable_xxx OU ancienne clé anon
SUPABASE_ANON_KEY="votre_cle_publishable_ou_anon"

# Clé Secrète (Backend) : sb_secret_xxx OU ancienne clé service_role
SUPABASE_SERVICE_ROLE_KEY="votre_cle_secret_ou_service_role"

# Port du serveur applicatif (défaut : 3000)
PORT=3000

# Assistant IA (Optionnel)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
